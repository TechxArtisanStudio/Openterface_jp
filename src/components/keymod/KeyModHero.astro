---
import KeyModWordmark from './KeyModWordmark.astro';
import KeyModHeroRail from './KeyModHeroRail.astro';
import { keymodLinks } from '../../i18n/keymodLanding';
import { getKeymodAsset } from '../../data/keymodAssets';
import type { KeymodLandingStrings } from '../../i18n/keymodLanding';

interface Props {
  copy: KeymodLandingStrings['hero'];
  crowdSupplyStats?: KeymodLandingStrings['crowdSupplyStats'];
}

const { copy, crowdSupplyStats } = Astro.props;
const heroAsset = getKeymodAsset('hero', 'center');

/** Load live campaign data from the generated JSON. */
let stats: {
  raised: number;
  goal: number;
  percentFunded: number;
  backers: number;
  daysLeft: number;
} | null = null;

if (crowdSupplyStats) {
  try {
    const data = await import('../../config/crowd-supply.generated.json').then((m) => m.default ?? m);
    stats = {
      raised: data.raised,
      goal: data.goal,
      percentFunded: data.percentFunded,
      backers: data.backers,
      daysLeft: data.daysLeft,
    };
  } catch {
    stats = null;
  }
}

function formatCurrency(n: number): string {
  return n >= 1000 ? `$${(n / 1000).toFixed(n % 1000 === 0 ? 0 : 1)}k` : `$${n}`;
}
---

<section class="km-hero km-hero--light" id="hero" aria-labelledby="hero-title">
  <div class="km-hero__content">
    <div class="km-hero__brand">
      <h1 id="hero-title" class="km-hero__product-name">
        <KeyModWordmark size="hero" />
        <span class="sr-only">{copy.productName}</span>
      </h1>
      <p class="km-hero__tagline">{copy.tagline}</p>
    </div>

    <div class="km-hero__stage">
      <div class="km-hero__image-wrap">
        {
          heroAsset?.src ? (
            <img
              class="km-hero__image"
              src={heroAsset.src}
              alt={heroAsset.alt}
              width="800"
              height="800"
              fetchpriority="high"
              decoding="async"
            />
          ) : null
        }
      </div>

      <div class="km-hero__equation" aria-hidden="true">
        <span class="km-hero__equation-plus">{copy.equationPlus}</span>
        <span class="km-hero__equation-eq" aria-hidden="true">{copy.equationEquals}</span>
      </div>

      <KeyModHeroRail />
    </div>

    {copy.headline ? <p class="km-hero__headline">{copy.headline}</p> : null}
    <p class="km-hero__lead">{copy.lead}</p>

    {stats && crowdSupplyStats ? (
      <div class="km-hero__campaign" aria-label={`${stats.percentFunded}% ${crowdSupplyStats.funded}`}>
        <div class="km-hero__campaign-top">
          <span class="km-hero__campaign-raised">
            <sup>$</sup>{stats.raised.toLocaleString()}
          </span>
          <span class="km-hero__campaign-raised-sub">
            {crowdSupplyStats.ofGoal.replace('{goal}', `$${stats.goal.toLocaleString()}`)}
          </span>
        </div>
        <div class="km-hero__campaign-track" role="progressbar" aria-valuenow={stats.percentFunded} aria-valuemin={0} aria-valuemax={100}>
          <div class="km-hero__campaign-fill" style={`width: ${Math.min(stats.percentFunded, 100)}%`}>
            <span class="km-hero__campaign-pct">{stats.percentFunded}% {crowdSupplyStats.funded}</span>
          </div>
        </div>
        <div class="km-hero__campaign-meta">
          <span class="km-hero__campaign-meta-item">
            <strong>{stats.backers}</strong> {crowdSupplyStats.backers}
          </span>
          <span class="km-hero__campaign-meta-dot" aria-hidden="true"></span>
          <span class="km-hero__campaign-meta-item">
            <strong>{stats.daysLeft}</strong> {crowdSupplyStats.daysLeft}
          </span>
        </div>
      </div>
    ) : null}

    <div class="km-hero__actions">
      <a
        href={keymodLinks.docs}
        class="km-btn km-btn--ghost"
        target="_blank"
        rel="noopener noreferrer"
        data-analytics-event="docs_click"
        data-analytics-product="keymod"
        data-analytics-placement="keymod_hero_docs"
      >
        {copy.docsCta}
      </a>
      <a
        href={keymodLinks.crowdSupply}
        class="km-btn km-btn--primary"
        target="_blank"
        rel="noopener noreferrer"
        data-analytics-event="crowdsupply_click"
        data-analytics-product="keymod"
        data-analytics-placement="keymod_hero"
      >
        {copy.preLaunchCta}
        <img
          class="km-btn__icon"
          src={keymodLinks.crowdSupplyIcon}
          alt=""
          width="20"
          height="20"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
      </a>
    </div>
  </div>
</section>
