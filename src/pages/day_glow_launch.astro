---
import BaseLayout from '../layouts/BaseLayout.astro';

const TARGET = 'https://www.youtube.com/live/txn5ixQNQTU';
---

<BaseLayout
  title="Day Glow Launch"
  description="Redirecting to the Day Glow Launch playlist on YouTube."
  canonicalPath="/day_glow_launch/"
  robots="noindex, nofollow"
>
  <meta http-equiv="refresh" content={`0;url=${TARGET}`} />
  <section class="flex min-h-[60vh] flex-col items-center justify-center px-4 py-16 text-center">
    <!-- Spinner -->
    <svg class="h-10 w-10 animate-spin text-primary-dark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z" />
    </svg>

    <p class="mt-6 text-lg font-medium text-primary-dark">Taking you to YouTube…</p>
    <p class="mt-2 text-sm text-muted">
      Don't see the video?
      <a href={TARGET} class="font-medium text-primary-dark underline hover:opacity-80">
        Click here
      </a>
    </p>
  </section>

  <script define:vars={{ target: 'https://www.youtube.com/live/txn5ixQNQTU' }}>
    // Immediate JS redirect as a faster alternative to meta refresh
    window.location.replace(target);
  </script>
</BaseLayout>
